# Copy to ingest/.env and fill in. Never commit the real file -- .env is gitignored.
# Everything here is optional; the service runs without it, degrading rather than failing.

# --- The Blue Alliance -------------------------------------------------------
# Free key from https://www.thebluealliance.com/account (Read API Keys).
# Without it, `alliances` and `tba_score` stay null: bumper OCR loses process-of-elimination
# down to three candidates per side, and the reconstructed-vs-official accuracy check has
# nothing to compare against.
TBA_API_KEY=

# --- Google Sheets export ----------------------------------------------------
# 1. Google Cloud console -> create a service account -> download its JSON key
# 2. Share the target spreadsheet with that service account's email (Editor)
# 3. Point the two variables below at the key file and the spreadsheet id
# Without both, POST /api/export/sheets returns 503 rather than reporting a write that did
# not happen.
SHEETS_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Storage and runtime -----------------------------------------------------
# SQLite by default; point at Postgres in production (doc 0 default port 5432).
DATABASE_URL=sqlite:///./frc_scouting.db

# Segments land in $FRC_DATA_DIR/segments, job output in $FRC_DATA_DIR/jobs.
FRC_DATA_DIR=./data

ANALYSIS_BINARY=./analysis/build/bin/analysis

# Used when a job does not name a season. Must have a contracts/seasons/<year>.json.
FRC_DEFAULT_SEASON=2026
