# Component 3 talks to component 2 over HTTP and nothing else.
#
# Leave VITE_API_MODE=fixture to run the whole UI with no backend at all, which is what
# doc 0 asks for ("Component 3 builds the whole UI against fixture data with no backend
# running"). Switch to `http` once component 2 is up on :8080.
VITE_API_MODE=fixture

# Only used when VITE_API_MODE=http. Vite proxies /api to this in dev (see vite.config.ts).
VITE_API_BASE=/api
